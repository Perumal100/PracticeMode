{
  "manifest_version": 3,
  "name": "PracticeMode - Form Scraper",
  "version": "2.0.0",
  "description": "Automatically discovers, extracts, and exports multi-step web form structures for practice and testing purposes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/utils.js",
        "content/dummy_data_generator.js",
        "content/field_extractor.js",
        "content/field_populator.js",
        "content/step_detector.js",
        "content/conditional_tracker.js",
        "content/navigation_controller.js",
        "content/extraction_state.js",
        "content/content_main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["tests/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
