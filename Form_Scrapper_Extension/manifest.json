{
  "manifest_version": 3,
  "name": "PracticeMode - Form Extractor",
  "version": "3.0.0",
  "description": "Copilot that discovers and exports the full structure of multi-step web forms for PracticeMode, using fictional data and never submitting.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/utils.js",
        "content/safety_policy.js",
        "content/regex_sampler.js",
        "content/dummy_data_generator.js",
        "content/option_harvester.js",
        "content/field_extractor.js",
        "content/field_populator.js",
        "content/step_detector.js",
        "content/conditional_tracker.js",
        "content/navigation_controller.js",
        "content/extraction_state.js",
        "content/content_main.js",
        "shared/export_builder.js",
        "shared/copilot_styles.js",
        "shared/copilot_ui.js",
        "shared/copilot_controller.js",
        "content/copilot_panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
