# Copy to .env and edit. .env is git-ignored; never commit real secrets.
# Every variable is optional: without a .env the backend runs locally with
# SQLite and development defaults. Real environment variables override this file.

# Chrome extension origin allowed to send imports (copy the ID from chrome://extensions).
# Separate several origins with commas.
DJANGO_CSRF_TRUSTED_ORIGINS=chrome-extension://your-extension-id

# PostgreSQL instead of the local SQLite file.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/practicemode

# Hosting only.
# DJANGO_SECRET_KEY=change-me-to-a-long-random-value
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=practicemode.example.com
# DJANGO_FORCE_HTTPS=true
